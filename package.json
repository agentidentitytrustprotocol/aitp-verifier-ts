{
  "name": "@agentidentitytrustprotocol/verifier",
  "version": "0.1.1",
  "description": "Independent TypeScript verifier for the Agent Identity & Trust Protocol (AITP), written from the RFCs. WebCrypto only, zero runtime dependencies.",
  "license": "Apache-2.0",
  "author": "AITP contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentidentitytrustprotocol/aitp-verifier-ts.git"
  },
  "homepage": "https://github.com/agentidentitytrustprotocol/aitp-verifier-ts#readme",
  "bugs": "https://github.com/agentidentitytrustprotocol/aitp-verifier-ts/issues",
  "keywords": [
    "aitp",
    "agent-identity",
    "verifier",
    "conformance",
    "jws",
    "jcs",
    "webcrypto"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "aitp-verifier-adapter": "bin/aitp-verifier-adapter.mjs"
  },
  "files": [
    "dist",
    "bin",
    "vendor/spec/schemas/conformance/known-answer/oidc-test-issuers.json",
    "SPEC_VERSION",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/stamp-build.mjs",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node build-test/test/run.js",
    "coverage": "npm run build:test && c8 node build-test/test/run.js",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --error-on-warnings .",
    "gen:errors": "node scripts/gen-errors.mjs",
    "check:errors": "node scripts/gen-errors.mjs --check",
    "sync:spec": "node scripts/sync-spec.mjs --spec-dir ../agentidentitytrustprotocol",
    "check:spec": "node scripts/sync-spec.mjs --spec-dir ../agentidentitytrustprotocol --check",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "c8": "12.0.0",
    "typescript": "7.0.2"
  }
}
